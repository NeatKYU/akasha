{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post-commit-record.sh",
            "timeout": 15,
            "statusMessage": "변경 기록 확인 중"
          }
        ]
      }
    ]
  }
}
